{
  "name": "life-cellular-playground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive Conway's Game of Life playground.",
  "scripts": {
    "start": "node server.mjs",
    "check": "node --check app.js && node --check server.mjs && node --check scripts/build-site.mjs && node --check scripts/check-deployment.mjs",
    "build": "node scripts/build-site.mjs",
    "test": "node scripts/build-site.mjs",
    "build:site": "node scripts/build-site.mjs",
    "serve:production": "node server.mjs --dir build/wasm/site --base /life-cellular-playground/",
    "test:production": "playwright test",
    "check:deployment": "node scripts/check-deployment.mjs",
    "build:debug": "node scripts/build-site.mjs --debug"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "yaml": "2.8.3"
  }
}
